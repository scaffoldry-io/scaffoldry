{
  "name": "scaffoldry-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm --workspace=@scaffoldry/web test",
    "build": "npm --workspace=@scaffoldry/web run build",
    "ui:audit": "node scripts/ui/run.mjs audit",
    "ui:smoke": "node scripts/ui/run.mjs smoke",
    "ui:mcp": "node scripts/ui/run.mjs mcp",
    "ui:all": "node scripts/ui/run.mjs all",
    "ui:test": "node --test scripts/ui/audit.test.mjs",
    "mcp:serve": "node scripts/mcp/serve.mjs",
    "mcp:client": "node scripts/mcp/client-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
