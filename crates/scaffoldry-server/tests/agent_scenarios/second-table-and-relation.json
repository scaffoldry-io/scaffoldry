{
  "id": "second-table-and-relation",
  "ask": "I need a second table for reviewers, linked to the applications.",
  "persona": "faculty-owner",
  "status": "supported",
  "steps": [
    {
      "tool": "propose_app_change",
      "args": {
        "workspace_id": "$ws",
        "summary": "A change",
        "manifest": {
          "slug": "$app",
          "title": "Scholarships",
          "description": "Scholarship applications",
          "organization_code": "PHYS",
          "department": "physics",
          "views": [],
          "tables": [
            {
              "id": "applications",
              "name": "Applications",
              "slug": "applications",
              "fields": [
                {
                  "name": "applicant",
                  "label": "Applicant",
                  "field_type": "Text",
                  "required": true,
                  "ferpa_sensitive": false
                },
                {
                  "name": "amount",
                  "label": "Amount",
                  "field_type": "Number",
                  "required": false,
                  "ferpa_sensitive": false
                },
                {
                  "name": "status",
                  "label": "Status",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                }
              ]
            }
          ]
        }
      },
      "save": {
        "p": "$.proposal_id"
      },
      "expect": {
        "checks.schema": "pass"
      }
    },
    {
      "tool": "decide_proposal",
      "args": {
        "proposal_id": "$p",
        "decision": "approve",
        "rationale": "Reviewed"
      },
      "expect": {
        "status": "Approved"
      }
    },
    {
      "tool": "propose_app_change",
      "args": {
        "workspace_id": "$ws",
        "summary": "A change",
        "manifest": {
          "slug": "$app",
          "title": "Scholarships",
          "description": "Scholarship applications",
          "organization_code": "PHYS",
          "department": "physics",
          "views": [],
          "tables": [
            {
              "id": "applications",
              "name": "Applications",
              "slug": "applications",
              "fields": [
                {
                  "name": "applicant",
                  "label": "Applicant",
                  "field_type": "Text",
                  "required": true,
                  "ferpa_sensitive": false
                },
                {
                  "name": "amount",
                  "label": "Amount",
                  "field_type": "Number",
                  "required": false,
                  "ferpa_sensitive": false
                },
                {
                  "name": "status",
                  "label": "Status",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                }
              ]
            },
            {
              "id": "reviewers",
              "name": "Reviewers",
              "slug": "reviewers",
              "fields": [
                {
                  "name": "name",
                  "label": "Name",
                  "field_type": "Text",
                  "required": true,
                  "ferpa_sensitive": false
                },
                {
                  "name": "department",
                  "label": "Department",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                }
              ]
            }
          ],
          "relationships": [
            {
              "id": "rel1",
              "name": "reviews",
              "source_table_id": "applications",
              "target_table_id": "reviewers",
              "source_field": "applicant",
              "target_field": "name",
              "relationship_type": "many_to_many",
              "display_field": "name"
            }
          ]
        }
      },
      "save": {
        "p2": "$.proposal_id"
      },
      "expect": {
        "checks.schema": "pass"
      }
    },
    {
      "tool": "decide_proposal",
      "args": {
        "proposal_id": "$p2",
        "decision": "approve",
        "rationale": "Reviewed"
      },
      "expect": {
        "status": "Approved"
      }
    },
    {
      "tool": "describe_app",
      "args": {
        "app_slug": "$app"
      },
      "expect": {
        "tables": {
          "len": 2
        },
        "relationships": {
          "len": 1
        },
        "version": 2
      }
    }
  ],
  "after": [
    {
      "ledger_has": "AppPublished"
    },
    {
      "no_error_leaks": true
    }
  ]
}
