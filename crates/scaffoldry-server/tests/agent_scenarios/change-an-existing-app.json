{
  "id": "change-an-existing-app",
  "ask": "Add a notes column to my scholarship app.",
  "persona": "faculty-owner",
  "status": "supported",
  "steps": [
    {
      "tool": "propose_app_change",
      "args": {
        "workspace_id": "$ws",
        "summary": "A change",
        "manifest": {
          "slug": "$app",
          "title": "Scholarships",
          "description": "Scholarship applications",
          "organization_code": "PHYS",
          "department": "physics",
          "views": [],
          "tables": [
            {
              "id": "applications",
              "name": "Applications",
              "slug": "applications",
              "fields": [
                {
                  "name": "applicant",
                  "label": "Applicant",
                  "field_type": "Text",
                  "required": true,
                  "ferpa_sensitive": false
                },
                {
                  "name": "amount",
                  "label": "Amount",
                  "field_type": "Number",
                  "required": false,
                  "ferpa_sensitive": false
                },
                {
                  "name": "status",
                  "label": "Status",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                }
              ]
            }
          ]
        }
      },
      "save": {
        "p": "$.proposal_id"
      },
      "expect": {
        "checks.schema": "pass"
      }
    },
    {
      "tool": "decide_proposal",
      "args": {
        "proposal_id": "$p",
        "decision": "approve",
        "rationale": "Reviewed"
      },
      "expect": {
        "status": "Approved"
      }
    },
    {
      "tool": "describe_app",
      "args": {
        "app_slug": "$app"
      },
      "expect": {
        "version": 1
      }
    },
    {
      "tool": "propose_app_change",
      "args": {
        "workspace_id": "$ws",
        "summary": "A change",
        "manifest": {
          "slug": "$app",
          "title": "Scholarships",
          "description": "Scholarship applications",
          "organization_code": "PHYS",
          "department": "physics",
          "views": [],
          "tables": [
            {
              "id": "applications",
              "name": "Applications",
              "slug": "applications",
              "fields": [
                {
                  "name": "applicant",
                  "label": "Applicant",
                  "field_type": "Text",
                  "required": true,
                  "ferpa_sensitive": false
                },
                {
                  "name": "amount",
                  "label": "Amount",
                  "field_type": "Number",
                  "required": false,
                  "ferpa_sensitive": false
                },
                {
                  "name": "status",
                  "label": "Status",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                }
              ]
            }
          ]
        }
      },
      "save": {
        "p2": "$.proposal_id"
      },
      "expect": {
        "checks.stale": "pass",
        "changes.0": {
          "contains": "notes"
        }
      }
    },
    {
      "tool": "decide_proposal",
      "args": {
        "proposal_id": "$p2",
        "decision": "approve",
        "rationale": "Reviewed"
      },
      "expect": {
        "status": "Approved"
      }
    },
    {
      "tool": "describe_app",
      "args": {
        "app_slug": "$app"
      },
      "expect": {
        "version": 2,
        "tables.0.fields": {
          "len": 4
        }
      }
    }
  ],
  "after": [
    {
      "ledger_has": "AppPublished"
    },
    {
      "no_error_leaks": true
    }
  ]
}
