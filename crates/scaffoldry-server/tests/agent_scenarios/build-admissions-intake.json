{
  "id": "build-admissions-intake",
  "ask": "I need a place to collect scholarship applications and have my chair approve the ones over $5,000.",
  "persona": "faculty-owner",
  "status": "supported",
  "steps": [
    {
      "tool": "propose_app_change",
      "args": {
        "workspace_id": "$ws",
        "summary": "A change",
        "manifest": {
          "slug": "$app",
          "title": "Scholarships",
          "description": "Scholarship applications",
          "organization_code": "PHYS",
          "department": "physics",
          "views": [],
          "tables": [
            {
              "id": "applications",
              "name": "Applications",
              "slug": "applications",
              "fields": [
                {
                  "name": "applicant",
                  "label": "Applicant",
                  "field_type": "Text",
                  "required": true,
                  "ferpa_sensitive": false
                },
                {
                  "name": "amount",
                  "label": "Amount",
                  "field_type": "Number",
                  "required": false,
                  "ferpa_sensitive": false
                },
                {
                  "name": "status",
                  "label": "Status",
                  "field_type": "Text",
                  "required": false,
                  "ferpa_sensitive": false
                }
              ]
            }
          ]
        }
      },
      "save": {
        "p": "$.proposal_id",
        "d_p": "$.digest"
      },
      "expect": {
        "checks.schema": "pass",
        "checks.stale": "pass"
      }
    },
    {
      "tool": "decide_proposal",
      "args": {
        "proposal_id": "$p",
        "decision": "approve",
        "rationale": "Reviewed",
        "digest": "$d_p"
      },
      "expect": {
        "status": "Approved"
      }
    },
    {
      "tool": "describe_app",
      "args": {
        "app_slug": "$app"
      },
      "expect": {
        "slug": "$app",
        "version": 1,
        "tables.0.name": "Applications"
      }
    },
    {
      "tool": "propose_app_change",
      "args": {
        "workspace_id": "$ws",
        "summary": "Chair reviews awards over $5,000",
        "rules": [
          {
            "id": "r-$suffix",
            "name": "Chair review",
            "enabled": true,
            "trigger": "RecordCreated",
            "predicates": [
              {
                "field_name": "amount",
                "operator": "GreaterThan",
                "expected_value": "5000"
              }
            ],
            "steps": [
              {
                "id": "decide",
                "when": [],
                "kind": {
                  "UserTask": {
                    "role": "owner",
                    "prompt": "Approve this award",
                    "approve": [
                      {
                        "UpdateRecordStatus": {
                          "new_status": "Admitted"
                        }
                      }
                    ],
                    "reject": [
                      {
                        "UpdateRecordStatus": {
                          "new_status": "Denied"
                        }
                      }
                    ],
                    "approver": {
                      "Role": {
                        "name": "owner"
                      }
                    }
                  }
                }
              }
            ]
          }
        ],
        "app_slug": "$app"
      },
      "save": {
        "rp": "$.proposal_id",
        "d_rp": "$.digest"
      }
    },
    {
      "tool": "decide_proposal",
      "args": {
        "proposal_id": "$rp",
        "decision": "approve",
        "rationale": "Reviewed",
        "digest": "$d_rp"
      },
      "expect": {
        "status": "Approved"
      }
    },
    {
      "tool": "create_record",
      "args": {
        "app_slug": "$app",
        "data": {
          "_table_id": "applications",
          "applicant": "Rosa Diaz",
          "amount": 7500,
          "status": "New"
        }
      },
      "expect": {
        "version": 1
      }
    }
  ],
  "after": [
    {
      "ledger_has": "AppPublished"
    },
    {
      "no_error_leaks": true
    }
  ]
}
