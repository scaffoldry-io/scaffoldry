// Scaffoldry Cedar schema.
// Every attribute is required. A non-member has member_role set to the empty string.
// Workspace.workspace_id equals the workspace's id.
// Workspace.unit_path_ids is the workspace's unit and every ancestor of it. User.admin_unit_ids is the units where the
// person is a unit administrator. A workspace asked about an app carries that app's sensitivity.
//
// Phase 2: One notion of place.
// Unit entity carries hierarchy attribute and ancestor units as parents.
// Workspace, App, Record, and System carry their unit attribute and parents.

entity Unit in [Unit] = {
  hierarchy: String,
};

entity User = {
  eppn: String,
  name: String,
  scoped_affiliation: String,
  department: String,
  units: Set<Unit>,
  unit_ids: Set<String>,
  admin_unit_ids: Set<String>,
  is_platform_admin: Bool,
};

entity Workspace in [Unit] = {
  workspace_id: String,
  department: String,
  visibility: String,
  data_classification: String,
  member_role: String,
  unit: Unit,
  unit_id: String,
  unit_path_ids: Set<String>,
  is_member: Bool,
  is_ferpa_sensitive: Bool,
  categories: Set<String>,
};

entity App in [Unit] = {
  slug: String,
  department: String,
  workspace_id: String,
  unit: Unit,
};

entity Record in [Unit] = {
  app_slug: String,
  department: String,
  workspace_id: String,
  unit: Unit,
  is_ferpa_sensitive: Bool,
  categories: Set<String>,
};

entity System in [Unit] = {
  department: String,
  unit: Unit,
  is_ferpa_sensitive: Bool,
};

action access_workspace, manage_workspace, delete_workspace
  appliesTo { principal: [User], resource: [Workspace] };

action read_app, manage_app
  appliesTo { principal: [User], resource: [Workspace, App] };

action write_record, comment
  appliesTo { principal: [User], resource: [Workspace, Record] };

action create_app, update_app, publish_app
  appliesTo { principal: [User], resource: [App, System] };

action read, write, export, run_automation
  appliesTo { principal: [User], resource: [Record] };

action approve
  appliesTo { principal: [User], resource: [Record, Workspace, System] };

action record_decision
  appliesTo { principal: [User], resource: [System, Record] };

action access_admin, impersonate, publish_dataset
  appliesTo { principal: [User], resource: [System] };
