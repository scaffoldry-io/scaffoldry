{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffoldry.io/schema/sensitivity-settings.schema.json",
  "title": "SensitivitySettings",
  "description": "The settings sensitivity.categories and sensitivity.detectors, and the preset files that hold one category with its detectors. A category names detector ids that must exist. Ids are unique within their list.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "detector": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["us_ssn", "payment_card", "email", "shape"] },
        "action": { "enum": ["flag", "warn", "block"], "default": "flag" },
        "enabled": { "type": "boolean", "default": true },
        "shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Only for kind shape. # is a digit, A is a letter, ? is a letter or digit, anything else is literal."
        },
        "checksum": { "enum": ["luhn"], "description": "Only for kind shape." },
        "allow_unseparated": { "type": "boolean", "description": "Only for kind us_ssn." }
      },
      "if": { "properties": { "kind": { "const": "shape" } } },
      "then": { "required": ["shape"] }
    },
    "category": {
      "type": "object",
      "required": ["id", "name", "protected", "detectors"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "type": "string", "maxLength": 128 },
        "protected": { "type": "boolean" },
        "default_mask": { "$ref": "mask.schema.json", "description": "What a reader who is not cleared sees of a field of this category. Hide when absent." },
        "detectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "The detectors whose matches signal this category. The content scan and the AI review both read this list, so it is the one mapping from patterns to categories."
        },
        "requires": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Who may read a row that carries this category: any one of these. A reader meets one when they hold the position at a unit its reach covers for the row. No list means no requirement.",
          "items": {
            "type": "object",
            "required": ["position", "reach"],
            "additionalProperties": false,
            "properties": {
              "position": { "$ref": "#/$defs/id", "description": "A position key, such as registrar." },
              "reach": { "enum": ["unit", "unit_and_below", "anywhere"], "description": "unit: rows at the unit where the position is held. unit_and_below: that unit and every unit under it. anywhere: every row." }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "sensitivity.categories",
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/category" }
    },
    {
      "title": "sensitivity.detectors",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/detector" }
    },
    {
      "title": "A preset file",
      "type": "object",
      "required": ["category", "detectors"],
      "additionalProperties": false,
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "detectors": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/detector" } }
      }
    }
  ]
}
