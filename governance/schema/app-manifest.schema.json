{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffoldry.io/schema/app-manifest.schema.json",
  "title": "AppManifest",
  "description": "The data contract of an app: tables, fields, views, relationships, and pages. Written by hand from the Rust types in scaffoldry-engine. validate_manifest enforces the same shape and also the rules JSON Schema cannot express: formulas name real fields, links reach real tables, page grants name real fields, and a grant never writes a computed field.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "description",
    "organization_code",
    "department",
    "views"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization_code": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "herm_capability_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "custom_domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "custom_domain_verified": {
      "type": "boolean",
      "description": "A proposal can never set this to true. Nothing in the platform verifies a domain yet."
    },
    "tables": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "views": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "ceds_mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "description": "The app's row and column rules. Their shapes are access-rules.schema.json and access-column-rules.schema.json, which validate_manifest and the access checks enforce.",
      "properties": {
        "rows": { "type": "array", "items": { "type": "object" } },
        "columns": { "type": "array", "items": { "type": "object" } }
      }
    },
    "sealed": { "type": "boolean", "description": "A sealed app stops every grant anchored above it. Grants at the app or inside it still reach. Unsealing needs a second person." },
    "pages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "fieldType": {
      "oneOf": [
        {
          "enum": [
            "Text",
            "Number",
            "Date",
            "Select",
            "Boolean",
            "Relation",
            "Checkbox",
            "MultiSelect",
            "Currency",
            "Percent",
            "Rating",
            "Email",
            "Phone",
            "Url",
            "Autonumber",
            "CreatedTime",
            "LastModifiedTime",
            "Lookup",
            "Count",
            "Rollup",
            "Formula",
            "Link",
            "Collaborator",
            "CreatedBy",
            "LastModifiedBy",
            "LongText",
            "Duration",
            "DateTime",
            "Attachment",
            "Button",
            "Unit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Collaborator": {
              "type": "object",
              "properties": {
                "allow_multiple": {
                  "type": "boolean"
                }
              }
            },
            "Duration": {
              "type": "object",
              "properties": {
                "format": {
                  "enum": [
                    "h:mm",
                    "h:mm:ss",
                    "d h",
                    "days"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "label",
        "field_type",
        "required",
        "ferpa_sensitive"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/fieldName"
        },
        "label": {
          "type": "string"
        },
        "field_type": {
          "$ref": "#/$defs/fieldType"
        },
        "required": {
          "type": "boolean"
        },
        "ferpa_sensitive": {
          "type": "boolean"
        },
        "retired_at": {
          "type": "string",
          "format": "date-time",
          "description": "When a proposal removed the field. A retired field is listed in its table's retired_fields, never in fields. Its values stay in the records until retention strips them."
        },
        "mask": {
          "type": "object",
          "description": "What a reader who is not cleared for the field sees of it. The shape is mask.schema.json. Showing more than the category's default raises the flagged check mask_weakened.",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["hide", "last4", "initials", "year", "month", "band"] },
            "width": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sensitivity category ids."
        },
        "hierarchy": {
          "type": "string",
          "minLength": 1,
          "description": "For a Unit field: the key of the hierarchy whose units the field holds. A table's unit column is a Unit field."
        },
        "linked_dataset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "linked_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_display_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_label_override": {
          "type": [
            "string",
            "null"
          ]
        },
        "cardinality": {
          "type": [
            "string",
            "null"
          ]
        },
        "allow_multiple": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "link_filter": {},
        "formula_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollup_function": {
          "type": [
            "string",
            "null"
          ]
        },
        "select_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currency_symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "indexed": {
          "type": "boolean",
          "description": "Sorting and filtering on this field use the pivot index. At most 20 per table. Not on a Lookup."
        },
        "link_target_table": {
          "type": [
            "string",
            "null"
          ],
          "description": "A Link field: the table it points at."
        },
        "link_target_app": {
          "type": [
            "string",
            "null"
          ],
          "description": "A Link field into a dataset app."
        },
        "link_cardinality": {
          "enum": [
            "One",
            "Many"
          ],
          "description": "How many records a Link field holds. Default Many."
        },
        "link_related_field": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Link field on the target table that points back."
        },
        "link_on_delete": {
          "enum": [
            "Unlink",
            "Restrict"
          ],
          "description": "What deleting a linked record does. Default Unlink."
        },
        "computed_via": {
          "type": [
            "string",
            "null"
          ],
          "description": "A Lookup, Rollup, or Count: the Link field of this table it goes through."
        },
        "notify_on_assign": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Sends the person a notification when added to a record."
        },
        "button_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "A Button field: the id of the rule with a Manual trigger that pressing it starts."
        },
        "duration_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "h:mm",
            "h:mm:ss",
            "d h",
            "days",
            null
          ]
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sealed": {
          "type": "boolean",
          "description": "A sealed table stops every grant anchored above it, for its rows too. Grants at the table reach. Unsealing needs a second person."
        },
        "key": {
          "type": "object",
          "description": "The table's key: the fields whose text identifies a row. Two live rows cannot share a key. The text is trimmed, and case-folded when case_fold is true. Setting it needs a proposal, and it is refused while rows already share a key.",
          "required": ["fields"],
          "additionalProperties": false,
          "properties": {
            "fields": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "case_fold": { "type": "boolean" }
          }
        },
        "unit_field": {
          "type": "string",
          "minLength": 1,
          "description": "The unit column: the name of one of the table's Unit fields. Each row's value is copied to an indexed column, and a value that is not a unit of the field's hierarchy is refused. A row that leaves it blank is the dataset's own. Setting it needs a proposal, and it is refused while a row holds a value that is not a unit."
        },
        "unit_required": {
          "type": "boolean",
          "description": "A row that names no unit is refused, by every door. It needs a unit_field. Off by default, so a table that named its unit column earlier still takes rows with none. Setting it needs a proposal, and it is refused while a row names none."
        },
        "audience": {
          "type": "array",
          "maxItems": 8,
          "description": "Audience fields (data layer phase 3b). Each names a field of the table whose value names people, positions or units. A person named in it reads the row, and writes it when grants is write, on the fields listed and no others. A person is an address. A position is key@unit-id. A unit is a unit id, and reaches the people at the unit and below. A group is group:id. It grants nothing a category's requirement withholds. Setting it needs a proposal.",
          "items": {
            "type": "object",
            "required": ["field", "fields"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string", "minLength": 1, "description": "A Text, Collaborator or Unit field of this table." },
              "grants": { "enum": ["read", "write"], "default": "read", "description": "What being named grants: read, or read and write." },
              "fields": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "The fields the grant reaches. A person named here sees these fields of the row and no others." },
              "unit_acceptance": { "type": "boolean", "description": "A unit named in this field gains nothing until the unit's steward accepts. Off by default." }
            }
          }
        },
        "retired_fields": {
          "type": "array",
          "maxItems": 200,
          "description": "The fields a proposal removed, each with retired_at. Nothing reads, writes, indexes or calculates them. A proposal that puts one back in fields restores it with its values.",
          "items": { "$ref": "#/$defs/field" }
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "primary_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_table_id",
        "target_table_id",
        "source_field",
        "target_field",
        "relationship_type",
        "display_field"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_table_id": {
          "type": "string"
        },
        "target_table_id": {
          "type": "string"
        },
        "source_field": {
          "type": "string"
        },
        "target_field": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "display_field": {
          "type": "string"
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "title",
        "view_type",
        "fields"
      ],
      "description": "Views leave the manifest in views.md phase 1. Until then this shape names only what the validator reads.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "view_type": {
          "enum": [
            "Table",
            "Grid",
            "Kanban",
            "Calendar",
            "Gallery",
            "Form",
            "Dashboard",
            "Detail"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "View"
              ],
              "additionalProperties": false,
              "properties": {
                "View": {
                  "type": "object",
                  "required": [
                    "view_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "view_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "Custom"
              ],
              "additionalProperties": false,
              "properties": {
                "Custom": {
                  "type": "object",
                  "required": [
                    "source_sha256",
                    "grants"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{64}$"
                    },
                    "grants": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/grant"
                      }
                    },
                    "format": {
                      "type": "string",
                      "enum": [
                        "module",
                        "bundle"
                      ],
                      "default": "module"
                    },
                    "dependencies": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "version",
                          "license"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "version": {
                            "type": "string",
                            "minLength": 1
                          },
                          "license": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "grant": {
      "type": "object",
      "required": [
        "table_id"
      ],
      "additionalProperties": false,
      "description": "The whole of what a custom page may do to one table. There is no wildcard. A table with no grant is invisible to the page.",
      "properties": {
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldName"
          },
          "uniqueItems": true
        },
        "write": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldName"
          },
          "uniqueItems": true
        },
        "create": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        }
      }
    }
  }
}
