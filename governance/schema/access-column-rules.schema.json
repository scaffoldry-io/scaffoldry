{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffoldry.io/schema/access-column-rules.schema.json",
  "title": "AccessColumnRules",
  "description": "Column rules of an app. A rule hides fields from, or makes them read-only for, everyone it does not name in `unless`. A Platform Admin is never held back.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "table_id", "fields", "mode"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 64 },
      "table_id": { "type": "string", "minLength": 1, "maxLength": 64 },
      "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
      "mode": { "enum": ["hidden", "read_only"] },
      "unless": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "affiliations": { "type": "array", "items": { "type": "string" } },
          "units": { "type": "array", "items": { "type": "string" } },
          "positions": { "type": "array", "items": { "type": "string" } },
          "roles": { "type": "array", "items": { "enum": ["viewer", "commenter", "editor", "admin", "owner"] } },
          "addresses": { "type": "array", "items": { "type": "string" } }
        }
      },
      "message": {
        "description": "One plain sentence written by the owner. It is shown to the person as the reason.",
        "type": ["string", "null"],
        "maxLength": 200
      }
    }
  }
}
